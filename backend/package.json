{
  "name": "diag-seconde-vie-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "@prisma/client": "^5.8.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/node": "^18.16.19",
    "prisma": "^5.8.0",
    "tsx": "^3.12.7",
    "typescript": "^5.4.2"
  }
}
